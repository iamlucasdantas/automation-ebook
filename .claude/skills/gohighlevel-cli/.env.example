# =====================================================================
# GoHighLevel CLI — configuração
# Copie para .env e preencha. NUNCA versione o .env.
# =====================================================================

# --- Obrigatório: API pública ----------------------------------------
# Private Integration Token: Settings > Private Integrations > Create New.
# Marque TODOS os escopos que o CLI vai usar (contacts, opportunities,
# calendars, conversations, workflows, locations, invoices, forms, users).
GHL_API_KEY=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ID da subconta (string longa da URL: /location/<ID>/dashboard)
GHL_LOCATION_ID=SUA_LOCATION_ID

# --- Recomendado: contexto local -------------------------------------
GHL_TIMEZONE=America/Sao_Paulo
GHL_CURRENCY=BRL
# Domínio white label da sua agência (usado em links e headers).
# Sem white label, deixe app.gohighlevel.com
GHL_APP_DOMAIN=app.gohighlevel.com
# Nome do negócio usado em faturas
GHL_BUSINESS_NAME=

# --- Opcional: API interna (criação de workflows) --------------------
# A API pública é SOMENTE LEITURA para workflows. Criar/atualizar exige o
# token Firebase da sua sessão no navegador.
#   1. chrome://extensions > Modo desenvolvedor > Carregar sem empacotamento
#      > selecione a pasta chrome-extension/
#   2. Abra sua conta GHL logada e clique no ícone da extensão
#   3. "Capturar token" > "Copiar" > cole os dois valores abaixo
# O refresh token expira ao deslogar do GHL — recapture quando falhar.
GHL_FIREBASE_REFRESH_TOKEN=
GHL_FIREBASE_API_KEY=

# --- Avançado ---------------------------------------------------------
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_INTERNAL_API_BASE=https://backend.leadconnectorhq.com
# GHL_TIMEOUT=30
# GHL_MAX_RETRIES=4
